{
  "name": "aiditor",
  "version": "0.1.0",
  "description": "Social Image as Code — author social media graphics as TypeScript and render them to SVG/PNG.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "social": "./build/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build",
    "fonts"
  ],
  "scripts": {
    "render": "tsx src/cli/index.ts render",
    "dev": "tsx src/cli/index.ts dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "docs": "tsx scripts/generate-component-docs.ts",
    "social:components": "tsx src/cli/index.ts components",
    "format": "prettier --write .",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
